@import "tailwindcss";

:root {
  --bg-base: #080810;
  --bg-surface: #0f0f1a;
  --bg-elevated: #161625;
  --bg-overlay: #1e1e30;

  --border-subtle: rgba(255,255,255,0.06);
  --border-default: rgba(255,255,255,0.10);
  --border-emphasis: rgba(255,255,255,0.16);

  --accent-blue: #4F9EFF;
  --accent-blue-dim: rgba(79,158,255,0.12);
  --accent-green: #34D399;
  --accent-green-dim: rgba(52,211,153,0.12);
  --accent-red: #F87171;
  --accent-red-dim: rgba(248,113,113,0.12);
  --accent-amber: #FBBF24;
  --accent-amber-dim: rgba(251,191,36,0.12);
  --accent-purple: #A78BFA;

  --text-primary: #F0F0FF;
  --text-secondary: rgba(240,240,255,0.60);
  --text-muted: rgba(240,240,255,0.35);
}

* { box-sizing: border-box; }

body {
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Noise texture overlay */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}

/* Ambient glow blobs */
body::after {
  content: '';
  position: fixed;
  top: -20%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(
    ellipse at center,
    rgba(79,158,255,0.05) 0%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

/* Glass card */
.glass {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
}

.glass::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.04) 0%,
    transparent 50%
  );
  pointer-events: none;
}

/* Elevated card */
.card {
  background: var(--bg-elevated);
  border: 1px solid var(--border-default);
  border-radius: 12px;
  transition: all 0.2s ease;
}

.card:hover {
  border-color: var(--border-emphasis);
  transform: translateY(-1px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}