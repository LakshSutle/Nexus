:root {
  --bg-base: #080810;
  --bg-surface: #0f0f1a;
  --bg-elevated: #161625;
  --bg-overlay: #1e1e30;

  --border-subtle: rgba(255,255,255,0.06);
  --border-default: rgba(255,255,255,0.10);
  --border-emphasis: rgba(255,255,255,0.16);

  --accent-blue: #4F9EFF;
  --accent-blue-dim: rgba(79,158,255,0.12);
  --accent-green: #34D399;
  --accent-green-dim: rgba(52,211,153,0.12);
  --accent-red: #F87171;
  --accent-red-dim: rgba(248,113,113,0.12);
  --accent-amber: #FBBF24;
  --accent-amber-dim: rgba(251,191,36,0.12);
  --accent-purple: #A78BFA;

  --text-primary: #F0F0FF;
  --text-secondary: rgba(240,240,255,0.60);
  --text-muted: rgba(240,240,255,0.35);
}

* { box-sizing: border-box; }

body {
  background: var(--bg-base);
  color: var(--text-primary);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Noise texture overlay */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}

/* Ambient glow blobs */
body::after {
  content: '';
  position: fixed;
  top: -20%;
  left: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(
    ellipse at center,
    rgba(79,158,255,0.05) 0%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 0;
}

/* Glass card */
.glass {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
}

.glass::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.04) 0%,
    transparent 50%
  );
  pointer-events: none;
}

/* Glass card (alias) */
.glass-card {
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: 16px;
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
}

.glass-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.04) 0%,
    transparent 50%
  );
  pointer-events: none;
}

/* Elevated card */
.card {
  background: var(--bg-elevated);
  border: 1px solid var(--border-default);
  border-radius: 12px;
  transition: all 0.2s ease;
}

.card:hover {
  border-color: var(--border-emphasis);
  transform: translateY(-1px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
}

/* Glow effects */
.glow-blue {
  box-shadow: 0 0 24px rgba(79,158,255,0.15),
              0 0 48px rgba(79,158,255,0.05);
}
.glow-green {
  box-shadow: 0 0 24px rgba(52,211,153,0.15),
              0 0 48px rgba(52,211,153,0.05);
}
.glow-red {
  box-shadow: 0 0 24px rgba(248,113,113,0.15),
              0 0 48px rgba(248,113,113,0.05);
}
.glow-amber {
  box-shadow: 0 0 24px rgba(251,191,36,0.15),
              0 0 48px rgba(251,191,36,0.05);
}

/* Gradient text */
.gradient-text {
  background: linear-gradient(
    135deg,
    #fff 0%,
    rgba(79,158,255,0.9) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Gradient text primary */
.text-gradient-primary {
  background: linear-gradient(
    135deg,
    #fff 0%,
    rgba(79,158,255,0.9) 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Gradient text aurora */
.text-gradient-aurora {
  background: linear-gradient(
    135deg,
    #34D399 0%,
    #4F9EFF 50%,
    #A78BFA 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Glow pills */
.glow-pill-green {
  background: rgba(52,211,153,0.15);
  border: 1px solid rgba(52,211,153,0.3);
  box-shadow: 0 0 12px rgba(52,211,153,0.2);
}

.glow-pill-yellow {
  background: rgba(251,191,36,0.15);
  border: 1px solid rgba(251,191,36,0.3);
  box-shadow: 0 0 12px rgba(251,191,36,0.2);
}

.glow-pill-red {
  background: rgba(248,113,113,0.15);
  border: 1px solid rgba(248,113,113,0.3);
  box-shadow: 0 0 12px rgba(248,113,113,0.2);
}

/* Status badge */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 100px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

/* Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--border-emphasis);
  border-radius: 4px;
}

/* Input */
input, textarea {
  background: var(--bg-overlay) !important;
  border: 1px solid var(--border-default) !important;
  border-radius: 10px !important;
  color: var(--text-primary) !important;
  transition: border-color 0.2s !important;
}
input:focus, textarea:focus {
  border-color: var(--accent-blue) !important;
  outline: none !important;
  box-shadow: 0 0 0 3px
    rgba(79,158,255,0.12) !important;
}

/* Button primary */
.btn-primary {
  background: var(--accent-blue);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 10px 20px;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.btn-primary::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(255,255,255,0.15) 0%,
    transparent 60%
  );
}
.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 20px
    rgba(79,158,255,0.4);
}

/* Shimmer skeleton */
@keyframes shimmer {
  0% { background-position: -1000px 0; }
  100% { background-position: 1000px 0; }
}
.skeleton {
  background: linear-gradient(
    90deg,
    var(--bg-elevated) 25%,
    var(--bg-overlay) 50%,
    var(--bg-elevated) 75%
  );
  background-size: 1000px 100%;
  animation: shimmer 2s infinite;
  border-radius: 8px;
}

/* Pulse dot */
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}
.pulse-dot {
  animation: pulse-dot 2s ease infinite;
}

/* Fade up animation */
@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.fade-up {
  animation: fade-up 0.5s ease-out;
}

/* Terminal BG */
.terminal-bg {
  background-image: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(255,255,255,0.01) 2px,
    rgba(255,255,255,0.01) 4px
  );
}
